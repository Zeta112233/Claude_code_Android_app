<?xml version="1.0" encoding="utf-8"?>
<!-- 用户消息：右对齐蓝色气泡 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="end"
    android:paddingStart="56dp"
    android:paddingEnd="12dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <FrameLayout
        android:id="@+id/msg_bubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bubble_user">

        <TextView
            android:id="@+id/msg_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/app_on_primary"
            android:paddingStart="14dp"
            android:paddingEnd="56dp"
            android:paddingTop="10dp"
            android:paddingBottom="26dp"
            android:textSize="15sp"
            android:lineSpacingMultiplier="1.2" />

        <ImageButton
            android:id="@+id/msg_copy"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="end|bottom"
            android:layout_marginEnd="4dp"
            android:layout_marginBottom="2dp"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:contentDescription="&#x590D;&#x5236;"
            android:focusable="false"
            android:padding="8dp"
            android:scaleType="center"
            android:src="@drawable/ic_copy_20"
            android:tint="@color/app_on_primary" />

    </FrameLayout>

</LinearLayout>
