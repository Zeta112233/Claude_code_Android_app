<?xml version="1.0" encoding="utf-8"?>
<!-- 助手回复：左对齐浅色气泡 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="start"
    android:paddingStart="12dp"
    android:paddingEnd="56dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/msg_sender_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Claude"
            android:textColor="@color/app_text_muted"
            android:textSize="11sp"
            android:paddingStart="4dp"
            android:paddingBottom="2dp" />

        <!-- 思考过程折叠栏（有 thinking 内容时显示） -->
        <LinearLayout
            android:id="@+id/thinking_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bubble_thinking"
            android:layout_marginBottom="4dp"
            android:visibility="gone">

            <!-- 点击展开/折叠的标题行 -->
            <TextView
                android:id="@+id/thinking_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="思考过程 ▶"
                android:textColor="@color/app_text_muted"
                android:textSize="12sp"
                android:textStyle="italic" />

            <!-- 展开后显示的思考全文 -->
            <TextView
                android:id="@+id/thinking_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="8dp"
                android:textColor="@color/app_text_hint"
                android:textSize="12sp"
                android:textStyle="italic"
                android:fontFamily="monospace"
                android:lineSpacingMultiplier="1.3"
                android:visibility="gone" />

        </LinearLayout>

        <FrameLayout
            android:id="@+id/msg_bubble"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bubble_assistant">

            <TextView
                android:id="@+id/msg_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/app_text_primary"
                android:paddingStart="14dp"
                android:paddingEnd="56dp"
                android:paddingTop="10dp"
                android:paddingBottom="26dp"
                android:textSize="14sp"
                android:lineSpacingMultiplier="1.3" />

            <ImageButton
                android:id="@+id/msg_copy"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="end|bottom"
                android:layout_marginEnd="4dp"
                android:layout_marginBottom="2dp"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:contentDescription="&#x590D;&#x5236;"
                android:focusable="false"
                android:padding="8dp"
                android:scaleType="center"
                android:src="@drawable/ic_copy_20"
                android:tint="@color/app_text_muted" />

        </FrameLayout>

    </LinearLayout>

</LinearLayout>
